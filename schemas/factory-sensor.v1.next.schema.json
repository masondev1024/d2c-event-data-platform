{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/masondev1024/d2c-event-data-platform/schemas/factory-sensor.v1.next.schema.json",
  "title": "Factory sensor canonical event v1 compatible evolution",
  "description": "A compatibility canary: quality metadata is optional, so existing v1 events remain valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_time",
    "ingested_at",
    "sensor_id",
    "temperature",
    "humidity",
    "status",
    "source"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "factory-sensor.v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "sensor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"
    },
    "temperature": {
      "type": "number",
      "minimum": -40,
      "maximum": 150
    },
    "humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "IDLE",
        "STOPPED",
        "ERROR"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic",
        "partition",
        "offset"
      ],
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "partition": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "device",
            "derived"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
